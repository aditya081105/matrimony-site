# ==============================================================================
# Poorvanchal Matrimony - Environment Configuration Template
# Copy this file to .env and customize for your deployment environment.
# ==============================================================================

# Core Django Settings
SECRET_KEY=change-this-to-a-secure-random-50-character-secret-in-production
DEBUG=False
ALLOWED_HOSTS=poorvanchalmatrimony.social,www.poorvanchalmatrimony.social,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://poorvanchalmatrimony.social,https://www.poorvanchalmatrimony.social

# Database Connection (Self-hosted PostgreSQL 16 on VPS)
DATABASE_URL=postgresql://poorvanchal_user:your_secure_password@127.0.0.1:5432/poorvanchal_db

# Cache & Rate Limiting Backend (Self-hosted Redis on VPS)
REDIS_URL=redis://127.0.0.1:6379/1

# Transactional Email Settings (Gmail SMTP with App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_google_app_password
DEFAULT_FROM_EMAIL=Poorvanchal Matrimony <your_email@gmail.com>
CONTACT_ADMIN_EMAIL=your_email@gmail.com

# UPI Payment Settings (Dynamic NPCI QR Generation)
UPI_ID=payments@poorvanchalmatrimony
UPI_NAME=Poorvanchal Matrimony
