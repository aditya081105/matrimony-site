# Django Core Settings
SECRET_KEY=replace-with-a-strong-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=poorvanchalmatrimony.social,www.poorvanchalmatrimony.social,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://poorvanchalmatrimony.social,https://www.poorvanchalmatrimony.social

# Database Connection (Neon PostgreSQL or local VPS PostgreSQL)
# Example: postgres://username:password@ep-cool-site-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://user:password@hostname:5432/dbname?sslmode=require

# Media File Storage: Cloudinary (Recommended for instant access to existing profile photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Settings (Gmail SMTP - Port 587 works out of the box on Oracle VPS)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-google-app-password
DEFAULT_FROM_EMAIL=Poorvanchal Matrimony <noreply@poorvanchalmatrimony.social>
CONTACT_ADMIN_EMAIL=admin@poorvanchalmatrimony.social

# Payment Configuration (UPI)
UPI_ID=payments@poorvanchalmatrimony
UPI_NAME=Poorvanchal Matrimony
