[Unit]
Description=Gunicorn daemon for Poorvanchal Matrimony
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/poorvanchalmatrimony
EnvironmentFile=/var/www/poorvanchalmatrimony/.env
ExecStart=/var/www/poorvanchalmatrimony/venv/bin/gunicorn \
          --workers 3 \
          --bind 127.0.0.1:8001 \
          --access-logfile /var/log/poorvanchal/access.log \
          --error-logfile /var/log/poorvanchal/error.log \
          core.wsgi:application
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
